<body>

  <div class="container">

    <div class="card">

      <h1>🔑 NFC UID Converter</h1>

      <div class="subtitle">
        Convert a Flipper Zero <code>.nfc</code> file's UID into the
        decimal identifier automatically.
      </div>

      <label class="drop-zone" id="dropZone" for="fileInput">

        <div class="drop-icon">📄</div>

        <div class="drop-title">
          Drop your .nfc file here
        </div>

        <div class="drop-description">
          or click to choose a file
        </div>

      </label>

      <input
        type="file"
        id="fileInput"
        accept=".nfc,text/plain"
      >

      <div class="error" id="error"></div>

      <div class="result" id="result">

        <div class="result-box">
          <div class="label">Original UID</div>
          <div class="value" id="originalUid"></div>
        </div>

        <div class="result-box">
          <div class="label">Reversed UID</div>
          <div class="value" id="reversedUid"></div>
        </div>

        <div class="result-box">
          <div class="label">Decimal ID</div>
          <div class="value decimal-value" id="decimalId"></div>

          <button
            class="copy-button"
            id="copyButton"
            type="button"
          >
            Copy Decimal ID
          </button>
        </div>

      </div>

      <div class="info">
        <strong>How it works:</strong><br>
        This tool finds the <code>UID:</code> line in your Flipper Zero
        NFC dump, reverses the UID bytes, and converts the result from
        hexadecimal to decimal.
        <br><br>
        <strong>Privacy:</strong> Your file is processed entirely in
        your browser. Nothing is uploaded to a server.
      </div>

      <div class="footer">
        NFC UID Converter • Runs locally in your browser
      </div>

    </div>

  </div>

  <script>
    const dropZone = document.getElementById("dropZone");
    const fileInput = document.getElementById("fileInput");

    const result = document.getElementById("result");
    const error = document.getElementById("error");

    const originalUid = document.getElementById("originalUid");
    const reversedUid = document.getElementById("reversedUid");
    const decimalId = document.getElementById("decimalId");

    const copyButton = document.getElementById("copyButton");


    /*
     * Convert a Flipper Zero UID into the decimal identifier.
     *
     * Example:
     *
     * UID: 85 B5 E3 FA
     *
     * Reverse:
     *
     * FA E3 B5 85
     *
     * Hex:
     *
     * FAE3B585
     *
     * Decimal:
     *
     * 4209227141
     */
    function convertUID(uid) {

      // Remove spaces, tabs, etc.
      const cleanUID = uid
        .replace(/\s/g, "")
        .toUpperCase();

      // This version expects a 4-byte UID.
      if (!/^[0-9A-F]{8}$/.test(cleanUID)) {
        throw new Error(
          "The UID must contain exactly 4 hexadecimal bytes."
        );
      }

      // Split into individual bytes.
      const bytes = [
        cleanUID.substring(0, 2),
        cleanUID.substring(2, 4),
        cleanUID.substring(4, 6),
        cleanUID.substring(6, 8)
      ];

      // Reverse the byte order.
      const reversed = [
        bytes[3],
        bytes[2],
        bytes[1],
        bytes[0]
      ].join("");

      // Convert to a JavaScript BigInt so large unsigned
      // 32-bit values are handled correctly.
      const decimal = BigInt("0x" + reversed).toString(10);

      return {
        original: bytes.join(" "),
        reversed: [
          bytes[3],
          bytes[2],
          bytes[1],
          bytes[0]
        ].join(" "),
        decimal: decimal
      };
    }


    /*
     * Read the UID line from a Flipper Zero .nfc file.
     */
    function extractUID(text) {

      const lines = text.split(/\r?\n/);

      for (const line of lines) {

        const match = line.match(
          /^\s*UID\s*:\s*(.+?)\s*$/
        );

        if (match) {
          return match[1];
        }
      }

      throw new Error(
        "No UID line was found in this NFC file."
      );
    }


    /*
     * Process the selected file.
     */
    async function processFile(file) {

      hideError();

      result.classList.remove("show");

      if (!file) {
        return;
      }

      try {

        const text = await file.text();

        const uid = extractUID(text);

        const converted = convertUID(uid);

        originalUid.textContent = converted.original;

        reversedUid.textContent = converted.reversed;

        decimalId.textContent = converted.decimal;

        result.classList.add("show");

      } catch (err) {

        showError(
          err.message ||
          "Something went wrong while reading the file."
        );
      }
    }


    /*
     * Show an error.
     */
    function showError(message) {

      error.textContent = "⚠️ " + message;

      error.classList.add("show");
    }


    /*
     * Hide the error.
     */
    function hideError() {

      error.textContent = "";

      error.classList.remove("show");
    }


    /*
     * Normal file selection.
     */
    fileInput.addEventListener("change", function() {

      if (this.files.length > 0) {
        processFile(this.files[0]);
      }

    });


    /*
     * Drag & drop.
     */

    dropZone.addEventListener("dragover", function(event) {

      event.preventDefault();

      dropZone.classList.add("dragover");

    });


    dropZone.addEventListener("dragleave", function() {

      dropZone.classList.remove("dragover");

    });


    dropZone.addEventListener("drop", function(event) {

      event.preventDefault();

      dropZone.classList.remove("dragover");

      const files = event.dataTransfer.files;

      if (files.length > 0) {
        processFile(files[0]);
      }

    });


    /*
     * Copy the decimal ID.
     */
    copyButton.addEventListener("click", async function() {

      const value = decimalId.textContent;

      try {

        await navigator.clipboard.writeText(value);

        const oldText = copyButton.textContent;

        copyButton.textContent = "✓ Copied!";

        setTimeout(function() {
          copyButton.textContent = oldText;
        }, 1500);

      } catch (err) {

        // Fallback for browsers where Clipboard API
        // isn't available.
        const textarea = document.createElement("textarea");

        textarea.value = value;

        document.body.appendChild(textarea);

        textarea.select();

        document.execCommand("copy");

        textarea.remove();

        copyButton.textContent = "✓ Copied!";

        setTimeout(function() {
          copyButton.textContent = "Copy Decimal ID";
        }, 1500);
      }

    });
  </script>

</body>
